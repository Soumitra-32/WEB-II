PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/web_db
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d
# ORIGINAL (Azure server) value - uncomment when the server subscription is renewed:
# ALLOWED_ORIGINS=https://busbooking.me
# LOCAL dev value (localhost + all production domains so CORS/Postman tests pass locally):
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://busbooking.me,http://busbooking.me,https://www.busbooking.me,http://www.busbooking.me