      "name": "01_create_user_1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique1 = Date.now() + '-' + Math.floor(Math.random() * 1000000);",
              "pm.collectionVariables.set('genStudentId1', 'STU-' + unique1);",
              "pm.collectionVariables.set('genEmail1', 'user1-' + unique1 + '@juniv.edu');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "var resJson1 = pm.response.json();",
              "var userData1 = resJson1.data || resJson1;",
              "if (userData1._id) { pm.collectionVariables.set('userId', userData1._id); }",
              "pm.collectionVariables.set('dupStudentId', userData1.studentId);",
              "pm.collectionVariables.set('dupEmail', userData1.universityEmail);",
              "pm.test('Response has an id', () => pm.expect(userData1._id).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Soumitra Saha\",\n  \"studentId\": \"{{genStudentId1}}\",\n  \"universityEmail\": \"{{genEmail1}}\",\n  \"department\": \"CSE\",\n  \"role\": \"student\"\n}",
