    {
      "name": "get_user_by_id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "const expectedUserId = pm.collectionVariables.get('userId');",
              "",
              "pm.test('Response contains correct User ID', function () {",
              "    const responseId = jsonData._id || (jsonData.data && jsonData.data._id);",
              "    pm.expect(responseId).to.eql(expectedUserId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
