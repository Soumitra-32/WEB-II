      "name": "04 - CREATE Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('success is true', () => pm.expect(json.success).to.eql(true));",
              "pm.test('Booking ID exists', () => pm.expect(json.data._id).to.be.a('string').and.not.empty);",
              "pm.test('Booking reference exists', () => pm.expect(json.data.bookingReference).to.be.a('string').and.not.empty);",
              "pm.test('Trip ID matches', () => pm.expect(String(json.data.tripId)).to.eql(pm.collectionVariables.get('tripId')));",
              "pm.test('Student ID matches', () => pm.expect(String(json.data.student)).to.eql(pm.collectionVariables.get('userId')));",
              "pm.test('Seat number is 1', () => pm.expect(json.data.seatNumber).to.eql(1));",
              "pm.test('Status is confirmed', () => pm.expect(json.data.status).to.eql('confirmed'));",
              "pm.collectionVariables.set('bookingId', json.data._id);",
              "pm.collectionVariables.set('bookingReference', json.data.bookingReference);"
            ]
          }
        }
