  "item": [
    {
      "name": "01 - CREATE Route",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('success is true', () => pm.expect(json.success).to.eql(true));",
              "pm.test('Route ID exists', () => pm.expect(json.data._id).to.be.a('string').and.not.empty);",
              "pm.test('Origin is correct', () => pm.expect(json.data.origin).to.eql('Test Origin'));",
              "pm.test('Destination is correct', () => pm.expect(json.data.destination).to.eql('Test Destination'));",
              "pm.test('Total seats is 40', () => pm.expect(json.data.totalSeats).to.eql(40));",
              "pm.collectionVariables.set('routeId', json.data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"Test Origin\",\n  \"destination\": \"Test Destination\",\n  \"departureTime\": \"10:00\",\n  \"days\": [\n    \"Monday\",\n    \"Wednesday\",\n    \"Friday\"\n  ],\n  \"totalSeats\": 40\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/routes",
