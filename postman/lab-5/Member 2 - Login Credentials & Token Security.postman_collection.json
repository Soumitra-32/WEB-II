{
  "info": {
    "_postman_id": "5b6df38e-f776-478c-8cdf-f4e6a272b31e",
    "name": "Member 2 - Login Credentials & Token Security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "57151836",
    "_collection_link": "https://go.postman.co/collection/57151836-5b6df38e-f776-478c-8cdf-f4e6a272b31e?source=collection_link"
  },
  "item": [
    {
      "name": "01_setup_user_for_login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Setup User Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "    const res = pm.response.json();",
              "    pm.environment.set('m2Email', res.data.universityEmail);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Member 2 Tester\",\n  \"studentId\": \"STU2-{{$randomInt}}\",\n  \"universityEmail\": \"user2_{{$randomInt}}@uni.edu\",\n  \"department\": \"EEE\",\n  \"password\": \"correct_pass_123\",\n  \"role\": \"student\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02_login_valid_credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Token returned', () => pm.expect(pm.response.json().token).to.exist);",
              "if (pm.response.code === 200) { pm.environment.set('m2AuthToken', pm.response.json().token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"universityEmail\": \"{{m2Email}}\",\n  \"password\": \"correct_pass_123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03_login_invalid_password_401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"universityEmail\": \"{{m2Email}}\",\n  \"password\": \"wrong_password_xyz\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04_access_protected_missing_token_401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05_access_protected_invalid_token_401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{bearer_token_0i5i}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://busbooking.me"
    },
    {
      "key": "bearer_token_0i5i",
      "secret": true
    }
  ]
}