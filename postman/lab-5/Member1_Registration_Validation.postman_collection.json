"raw": "{\n  "name": "Member1 Test Student",\n  "studentId": "{{m1StudentId}}",\n  "universityEmail": "{{m1Email}}",\n  "department": "CSE",\n  "password": "password123",\n  "role": "student"\n}",
"options": {
