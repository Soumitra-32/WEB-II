"{{baseUrl}}"
],
"path": []
}
},
"response": []
},
{
"name": "01_register_student_valid",
"event": [
{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test("Status code is 201", () => pm.response.to.have.status(201));",
"pm.test("Response has success true", () => pm.expect(pm.response.json().success).to.eql(true));",
"pm.test("Response contains JWT token", () => pm.expect(pm.response.json().token).to.exist);",
"pm.test("Password is not returned", () => pm.expect(pm.response.json().data.password).to.not.exist);",
"if (pm.response.code === 201) {",
"    pm.environment.set("m1Token", pm.response.json().token);",
"    pm.environment.set("m1UserId", pm.response.json().data.id);",
"}"
]
}
}
],
