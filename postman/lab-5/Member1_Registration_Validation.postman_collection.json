"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test("Status code is 409 Conflict", () => pm.response.to.have.status(409));",
"pm.test("Success flag is false", () => pm.expect(pm.response.json().success).to.eql(false));"
]
}
}
