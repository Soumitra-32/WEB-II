{
"info": {
"_postman_id": "44edec6d-438e-4c12-8b64-014bd3854352",
"name": "Member 1 - Student Registration & Validation Tests",
"description": "Covers user model validation on registration: required fields, email format, password length, duplicate email/studentId rejection, and confirming a newly registered user can immediately use their token.",
"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
},
"item": [
{
"name": "00_generate_unique_identifiers",
"event": [
{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"const rand = Date.now();",
"pm.environment.set("m1StudentId", "STU-M1-" + rand);",
"pm.environment.set("m1Email", "m1student" + rand + "@uni.edu");",
"pm.test("API is reachable", () => pm.response.to.have.status(200));"
]
}
}
],
