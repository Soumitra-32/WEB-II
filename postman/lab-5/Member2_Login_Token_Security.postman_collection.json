{
  "info": {
    "_postman_id": "1a8c5c38-f7cd-4181-b510-6c7dd845b529",
    "name": "Member 2 - Login Credentials & Token Security",
    "description": "Covers login with correct/incorrect credentials, JWT structure verification, and access to protected routes with valid, missing, malformed, and tampered tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00_generate_unique_identifiers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rand = Date.now();",
              "pm.environment.set(\"m2StudentId\", \"STU-M2-\" + rand);",
              "pm.environment.set(\"m2Email\", \"m2student\" + rand + \"@uni.edu\");",
              "pm.environment.set(\"m2Password\", \"password123\");",
              "pm.test(\"API is reachable\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      },
      "response": []
    },
    {
      "name": "01_setup_user_for_login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Setup registration succeeded (201)\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.environment.set(\"m2UserId\", json.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Member2 Login Test User\",\n  \"studentId\": \"{{m2StudentId}}\",\n  \"universityEmail\": \"{{m2Email}}\",\n  \"department\": \"EEE\",\n  \"password\": \"{{m2Password}}\",\n  \"role\": \"student\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "02_login_valid_credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Response contains a JWT token\", () => {",
              "    pm.expect(json.token).to.exist;",
              "    pm.expect(json.token.split(\".\").length).to.eql(3);",
              "  });",
              "  pm.environment.set(\"m2ValidToken\", json.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"universityEmail\": \"{{m2Email}}\",\n  \"password\": \"{{m2Password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "03_login_wrong_password_expect_401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
              "if (pm.response.code === 401) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Generic error message (no user enumeration)\", () => {",
              "    pm.expect(json.message.toLowerCase()).to.include(\"invalid\");",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"universityEmail\": \"{{m2Email}}\",\n  \"password\": \"wrongPassword999\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "04_login_nonexistent_email_expect_401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401 (not 404, to avoid leaking which emails exist)\", () => {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"universityEmail\": \"doesnotexist{{m2StudentId}}@uni.edu\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "05_access_protected_route_valid_token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 with valid token\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{m2ValidToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06_access_protected_route_missing_token_expect_401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401 when no token supplied\", () => pm.response.to.have.status(401));",
              "if (pm.response.code === 401) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Error mentions no token\", () => pm.expect(json.message.toLowerCase()).to.include(\"token\"));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "07_access_protected_route_malformed_token_expect_401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401 for invalid token\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer this.is.not.a.valid.jwt"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "08_access_protected_route_expired_or_tampered_token_expect_401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401 for tampered token signature\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{m2ValidToken}}tampered"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "09_cleanup_test_user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cleanup returns 200 or 403 (non-admin cannot self-delete)\", () => {",
              "  pm.expect([200, 403]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{m2ValidToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{m2UserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{m2UserId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": []
}