{
  "info": {
    "_postman_id": "5800185e-cb33-4bb9-9274-11bc1859c9d8",
    "name": "Member 3 - RBAC & Admin Permissions",
    "description": "Covers role-based access control: student vs admin permissions on create/delete operations for trips and users, verifying 403 Forbidden for students and success for admins.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "57151836",
    "_collection_link": "https://go.postman.co/collection/57151836-5800185e-cb33-4bb9-9274-11bc1859c9d8?source=collection_link"
  },
  "item": [
    {
      "name": "00_generate_unique_identifiers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rand = Date.now();",
              "pm.environment.set(\"m3StudentId\", \"STU-M3-\" + rand);",
              "pm.environment.set(\"m3AdminId\", \"ADM-M3-\" + rand);",
              "pm.environment.set(\"m3StudentEmail\", \"m3student\" + rand + \"@uni.edu\");",
              "pm.environment.set(\"m3AdminEmail\", \"m3admin\" + rand + \"@uni.edu\");",
              "pm.test(\"API is reachable\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "01_register_admin_account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Admin registered (201)\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  const role = json.data ? json.data.role : json.role;",
              "  const token = json.token || json.accessToken;",
              "  const userId = json.data ? (json.data._id || json.data.id) : (json._id || json.id);",
              "  pm.test(\"Role saved as admin\", () => pm.expect(role).to.eql(\"admin\"));",
              "  pm.environment.set(\"m3AdminToken\", token);",
              "  pm.environment.set(\"m3AdminUserId\", userId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Member3 Admin\",\n  \"studentId\": \"{{m3AdminId}}\",\n  \"universityEmail\": \"{{m3AdminEmail}}\",\n  \"department\": \"Admin Office\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02_register_student_account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Student registered (201)\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  const role = json.data ? json.data.role : json.role;",
              "  const token = json.token || json.accessToken;",
              "  const userId = json.data ? (json.data._id || json.data.id) : (json._id || json.id);",
              "  pm.test(\"Role saved as student\", () => pm.expect(role).to.eql(\"student\"));",
              "  pm.environment.set(\"m3StudentToken\", token);",
              "  pm.environment.set(\"m3StudentUserId\", userId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Member3 Student\",\n  \"studentId\": \"{{m3StudentId}}\",\n  \"universityEmail\": \"{{m3StudentEmail}}\",\n  \"department\": \"CSE\",\n  \"password\": \"password123\",\n  \"role\": \"student\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03_student_create_trip_expect_403",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 403 Forbidden for student\", () => pm.response.to.have.status(403));",
              "if (pm.response.code === 403) {",
              "  const json = pm.response.json();",
              "  pm.test(\"Message explains role restriction\", () => pm.expect(json.message.toLowerCase()).to.include(\"not permitted\"));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{m3StudentToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"Campus\",\n  \"destination\": \"City Center\",\n  \"departureTime\": \"2026-09-15T08:00:00.000Z\",\n  \"capacity\": 40,\n  \"busNumber\": \"BUS-101\",\n  \"fare\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/trips",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05_student_delete_user_expect_403",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 403 (student cannot delete users)\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{m3StudentToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/000000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "000000000000000000000000"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06_admin_delete_nonexistent_user_expect_404_not_403",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is NOT 403 - admin role check passed\", () => pm.expect(pm.response.code).to.not.equal(403));",
              "pm.test(\"Status is 404 - valid admin, nonexistent target user\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{m3AdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/000000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "000000000000000000000000"
          ]
        }
      },
      "response": []
    },
