{
  "info": {
    "_postman_id": "66d4b7c2-60a4-4700-9f3d-567131c86a9d",
    "name": "Member 3 - RBAC & Admin Permissions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
