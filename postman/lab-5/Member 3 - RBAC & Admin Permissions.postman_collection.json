  },
  "item": [
    {
      "name": "01_register_admin_account",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.environment.set('m3AdminToken', pm.response.json().token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"System Admin M3\",\n  \"studentId\": \"ADM3-{{$randomInt}}\",\n  \"universityEmail\": \"admin3_{{$randomInt}}@uni.edu\",\n  \"department\": \"Administration\",\n  \"password\": \"adminpass123\",\n  \"role\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02_register_standard_student_account",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.environment.set('m3StudentToken', pm.response.json().token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Low Level User\",\n  \"studentId\": \"STU3-{{$randomInt}}\",\n  \"universityEmail\": \"user3_{{$randomInt}}@uni.edu\",\n  \"department\": \"BBA\",\n  \"password\": \"userpass123\",\n  \"role\": \"student\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03_test_student_access_to_admin_route_expect_403",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{m3StudentToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/000000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "000000000000000000000000"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04_test_admin_access_to_admin_route_pass_403",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('RBAC Passed: Status is NOT 403 Forbidden', () => pm.expect(pm.response.code).to.not.equal(403));",
              "pm.test('Status is 404 Not Found (valid role, dummy resource ID)', () => pm.response.to.have.status(404));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{m3AdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/000000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "000000000000000000000000"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://busbooking.me"
    }
  ]
}