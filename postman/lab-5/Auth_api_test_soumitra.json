  "item": [
    {
      "name": "01_register_student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Token present', () => {",
              "    pm.expect(pm.response.json().token).to.exist;",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    pm.environment.set('studentToken', response.token);",
              "    pm.environment.set('studentEmail', response.data.universityEmail);",
              "    pm.environment.set('studentPassword', 'password123');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Student\",\n  \"studentId\": \"STU-{{$randomInt}}\",\n  \"universityEmail\": \"student{{$randomInt}}@uni.edu\",\n  \"department\": \"CSE\",\n  \"password\": \"password123\",\n  \"role\": \"student\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
